---
import BaseLayout from './BaseLayout.astro';
import '../styles/blog.scss';
import type { CollectionEntry } from 'astro:content';
import { getBase } from '../consts';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, fullscreen, excerpt, cover } = post.data;
const base = getBase();

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout title={title} description={excerpt} image={cover} type="article" fullscreen={fullscreen}>
  {fullscreen ? (
    <slot />
  ) : (
    <>
      <a class="back-link" href={`${base}posts/`} data-back-link>&lt;&lt; go back</a>
      <article class="post single">
        <h1>{title}</h1>
        <div class="entry">
          <slot />
        </div>
        <div class="date">Written on {formatDate(date)}</div>
      </article>
    </>
  )}
</BaseLayout>

<script>
  import { goBack } from '../lib/back';

  // Delegated so it keeps working after Astro's client-side page swaps.
  document.addEventListener('click', (e) => {
    if ((e.target as Element | null)?.closest?.('a[data-back-link]')) goBack(e);
  });
</script>
