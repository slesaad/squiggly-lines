---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE, getBase } from '../consts';

interface Props {
  title?: string;
  fullscreen?: boolean;
}

const { title, fullscreen = false } = Astro.props;
const base = getBase();

// Every page except fullscreen posts scrolls as a normal page, with the footer at the end.
const flow = !fullscreen;
---

<!doctype html>
<html lang="en-US" style={`--display-picture-light: url("${base}images/cool.png"); --display-picture-dark: url("${base}images/sleepy.png");`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Yomogi&family=Comforter+Brush&family=Mansalva&family=Schoolbell&family=Comic+Neue&display=swap"
      rel="stylesheet"
    />
    <title>{title ?? SITE.name}</title>
    <ViewTransitions />
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved) {
          document.documentElement.setAttribute('data-theme', saved);
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();

      document.addEventListener('astro:before-swap', (e) => {
        const current = document.documentElement.getAttribute('data-theme');
        if (current) {
          e.newDocument.documentElement.setAttribute('data-theme', current);
        }
      });
    </script>
  </head>
  <body class:list={[{ 'layout-fullscreen': fullscreen, 'layout-flow': flow }]}>
    {!fullscreen && <Header />}
    <div class="main">
      {!fullscreen && <Sidebar />}
      <div class="content-wrapper">
        <div class="content">
          <slot />
        </div>
      </div>
    </div>
    {!fullscreen && <Footer />}
    {fullscreen && (
      <div class="floating-theme-toggle">
        <ThemeToggle />
      </div>
    )}
  </body>
</html>

<style is:global>
  .floating-theme-toggle {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 30;
  }

  .floating-theme-toggle .theme-toggle {
    margin-top: 0;
    background: var(--bg-color);
  }
</style>
