---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBase } from '../consts';
import { getSortedPosts } from '../lib/posts';

const base = getBase();
const latest = (await getSortedPosts()).slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }).toLowerCase();
---

<BaseLayout>
  <div class="home">
    <section class="intro">
      <h1>heyyo, i'm slesa! <span aria-hidden="true">👋</span></h1>
      <ul class="facts">
        <li><span class="emoji" aria-hidden="true">💻</span>
          <span>i'm a computer scientist / software developer.</span></li>
        <li><span class="emoji" aria-hidden="true">🛠️</span>
          <span>i'm currently working with the <a href="https://impact.earthdata.nasa.gov/">impact</a> team under
          <a href="https://earthdata.nasa.gov/esds">nasa's esds program</a>. at impact, i work with various earth
          science 🌎 data, products and algorithms.</span></li>
        <li><span class="emoji" aria-hidden="true">🎨</span>
          <span>i like making comics 💭, animations 🎭, digital/traditional painting 🖍️; all kind of art, really.
          see some of my stuff <a href="https://www.instagram.com/saanostory/">@saanostory</a>.</span></li>
      </ul>
    </section>

    <div class="squiggle divider" aria-hidden="true"></div>

    {latest.length > 0 && (
      <section class="latest" aria-labelledby="latest-heading">
        <h2 id="latest-heading">latest posts</h2>
        <ul class="recent">
          {latest.map((post) => (
            <li>
              <a href={`${base}posts/${post.id}/`}>{post.data.title}</a>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            </li>
          ))}
        </ul>
        <a class="see-all" href={`${base}posts/`}>see all posts &rarr;</a>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .home {
    max-width: 720px;
  }

  h1 {
    font-size: 32px;
    color: var(--accent-color);
    margin-bottom: 16px;
  }

  h2 {
    font-size: 26px;
    color: var(--accent-color);
    margin-bottom: 12px;
  }

  .facts,
  .recent {
    list-style: none;
  }

  .facts li {
    display: grid;
    grid-template-columns: 2em 1fr;
    line-height: 1.5;
    margin-bottom: 12px;
  }

  .divider {
    margin: 32px 0;
    color: var(--border-color);
  }

  .recent li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 6px 0;
  }

  /* Dotted leader between title and date */
  .recent li::after {
    content: '';
    order: 1;
    flex: 1;
    border-bottom: 2px dotted var(--border-color);
    transform: translateY(-4px);
  }

  .home .latest .recent a {
    color: var(--text-color);
    transition: color 0.2s;
  }

  .home .latest .recent a:hover {
    color: var(--accent-color);
  }

  .recent time {
    order: 2;
    font-size: 16px;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .see-all {
    display: inline-block;
    margin-top: 16px;
    color: var(--accent-color) !important;
  }

  .see-all:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 780px) {
    .recent li {
      flex-wrap: wrap;
      gap: 0 12px;
    }

    .recent li::after {
      display: none;
    }
  }
</style>
