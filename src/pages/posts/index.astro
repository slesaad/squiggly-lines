---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { PAGINATION, getBase } from '../../consts';
import { getSortedPosts, pageCount } from '../../lib/posts';
import '../../styles/blog.scss';

const posts = await getSortedPosts();
const base = getBase();
const next = pageCount(posts.length) > 1 ? `${base}posts/page/2/` : undefined;
---

<BaseLayout title="Posts">
  <PostList posts={posts.slice(0, PAGINATION.perPage)} page={{ url: { next } }} />
</BaseLayout>
