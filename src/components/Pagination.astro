---
interface Props {
  page: {
    url: {
      prev?: string;
      next?: string;
    };
  };
}

const { page } = Astro.props;
---

{
  (page.url.prev || page.url.next) && (
    <nav class="pagination" aria-label="Pagination">
      {page.url.prev ? <a href={page.url.prev}>&larr; newer posts</a> : <span />}
      {page.url.next ? <a href={page.url.next}>older posts &rarr;</a> : <span />}
    </nav>
  )
}
